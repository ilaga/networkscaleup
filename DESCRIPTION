Package: networkscaleup
Title: Network Scale-Up Models for Aggregated Relational Data
Version: 0.2-1
Authors@R: 
    c(person("Ian", "Laga", , "owengward@gmail.com", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-5164-4856")),
